<?php
// Evitar que se muestre cualquier error en la salida
error_reporting(E_ALL);
ini_set('display_errors', 0);

// Iniciar buffer de salida
ob_start();

// Función para enviar respuesta JSON y terminar
function enviar_respuesta($data) {
    // Limpiar cualquier salida anterior
    if (ob_get_length()) ob_clean();
    
    // Asegurar que se envíe como JSON
    header('Content-Type: application/json');
    echo json_encode($data);
    exit;
}

// Manejador de errores personalizado
function exception_error_handler($errno, $errstr, $errfile, $errline) {
    error_log("Error [$errno] $errstr en $errfile:$errline");
    enviar_respuesta(['success' => false, 'message' => 'Error interno del servidor']);
}
set_error_handler("exception_error_handler");

// Iniciar sesión
session_start();

try {
    require_once 'conexion.php';

if (!isset($_SESSION['usuario'])) {
    echo json_encode(['success' => false, 'message' => 'No hay sesión activa']);
    exit;
}

$conn = conexion();
if (!$conn) {
    echo json_encode(['success' => false, 'message' => 'Error de conexión a la base de datos']);
    exit;
}

// Verificar y sanitizar los datos recibidos
$nombre = trim($_POST['nombre'] ?? '');
$email = filter_var(trim($_POST['email'] ?? ''), FILTER_SANITIZE_EMAIL);
$telefono = trim($_POST['telefono'] ?? '');
$password = trim($_POST['password'] ?? '');

// Validaciones básicas
if (empty($nombre) || empty($email)) {
    echo json_encode(['success' => false, 'message' => 'El nombre y el email son obligatorios']);
    exit;
}

if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
    echo json_encode(['success' => false, 'message' => 'El formato del email no es válido']);
    exit;
}

$usuario_id = $_SESSION['id'] ?? $_SESSION['user_id'] ?? $_SESSION['usuario_id'] ?? null;

if (!$usuario_id) {
    error_log('ID de usuario no encontrado en sesión: ' . print_r($_SESSION, true));
    echo json_encode(['success' => false, 'message' => 'Error: ID de usuario no encontrado']);
    exit;
}

// Validar email único si se está cambiando
$query = "SELECT id FROM usuarios WHERE email = ? AND id != ?";
if (!($stmt = $conn->prepare($query))) {
    echo json_encode(['success' => false, 'message' => 'Error al preparar la consulta: ' . $conn->error]);
    exit;
}

$stmt->bind_param("si", $email, $usuario_id);

if (!$stmt->execute()) {
    echo json_encode(['success' => false, 'message' => 'Error al verificar email: ' . $stmt->error]);
    $stmt->close();
    exit;
}

$result = $stmt->get_result();
if ($result->num_rows > 0) {
    echo json_encode(['success' => false, 'message' => 'El correo electrónico ya está en uso']);
    $stmt->close();
    exit;
}
$stmt->close();
    
// Primero verificamos si el email ya existe (excluyendo el usuario actual)
$check_email = "SELECT id FROM usuarios WHERE email = ? AND id != ?";
if (!($stmt = $conn->prepare($check_email))) {
    echo json_encode(['success' => false, 'message' => 'Error al preparar la verificación de email: ' . $conn->error]);
    exit;
}

$stmt->bind_param("si", $email, $usuario_id);
if (!$stmt->execute()) {
    echo json_encode(['success' => false, 'message' => 'Error al verificar el email: ' . $stmt->error]);
    $stmt->close();
    exit;
}

$result = $stmt->get_result();
if ($result->num_rows > 0) {
    echo json_encode(['success' => false, 'message' => 'El correo electrónico ya está en uso por otro usuario']);
    $stmt->close();
    exit;
}
$stmt->close();

// Preparar la consulta de actualización
$sql = "UPDATE usuarios SET nombre = ?, email = ?, contacto = ?";
$params = [$nombre, $email, $telefono];
$tipos = "sss";

// Si se proporcionó una nueva contraseña, incluirla en la actualización
if (!empty($password)) {
    $sql .= ", clave = ?";
    $hash = password_hash($password, PASSWORD_DEFAULT);
    $params[] = $hash;
    $tipos .= "s";
}

$sql .= " WHERE id = ?";
$params[] = $usuario_id;
$tipos .= "i";

// Preparar la consulta
if (!($stmt = $conn->prepare($sql))) {
    echo json_encode(['success' => false, 'message' => 'Error al preparar la actualización: ' . $conn->error]);
    exit;
}

// Crear un array de referencias para bind_param
$ref = array($tipos);
foreach($params as $key => $value) {
    $ref[] = &$params[$key];
}

// Bind parameters
try {
    call_user_func_array(array($stmt, 'bind_param'), $ref);

    // Ejecutar la consulta
    if (!$stmt->execute()) {
        echo json_encode(['success' => false, 'message' => 'Error al actualizar los datos: ' . $stmt->error]);
        $stmt->close();
        $conn->close();
        exit;
    }

    // Verificar si se hicieron cambios
    if ($stmt->affected_rows >= 0) { // Cambiado de > 0 a >= 0 porque puede ser que los datos sean los mismos
        // Actualizar la sesión
        $_SESSION['nombre'] = $nombre;
        $_SESSION['email'] = $email;
        
        echo json_encode([
            'success' => true, 
            'message' => 'Datos actualizados correctamente',
            'changes' => $stmt->affected_rows
        ]);
    } else {
        echo json_encode([
            'success' => false, 
            'message' => 'Error al actualizar los datos: ' . $stmt->error
        ]);
    }

    $stmt->close();
    $conn->close();
    
    // Limpiamos cualquier salida previa
    ob_clean();
    
} catch (Exception $e) {
    // Limpiamos cualquier salida previa
    ob_clean();
    
    error_log("Error en actualizar_cuenta.php: " . $e->getMessage());
    echo json_encode([
        'success' => false, 
        'message' => 'Error al actualizar los datos: ' . $e->getMessage()
    ]);
}

// Aseguramos que no haya más salida después del JSON
exit();
}
?>
